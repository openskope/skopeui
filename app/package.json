{
  "name": "skopeui",
  "version": "v2022.05.1-nuxt3-ready",
  "private": true,
  "description": "Skope dataset discovery, visualization, and analysis frontend",
  "engines": {
    "node": "^26.13.1",
    "npm": "^12.2.2"
  },
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "preview": "nuxt preview --host 0.0.0.0",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lintfix": "eslint . --fix",
    "format": "prettier --write \"/repo/**/*.{js,mjs,ts,vue,scss,json,md,yml,yaml}\" --ignore-path /repo/.prettierignore && npm run lintfix",
    "typecheck": "nuxt typecheck",
    "types:metadata": "node scripts/metadata-types.mjs",
    "check:metadata": "node scripts/metadata-validator.mjs",
    "test": "vitest run",
    "test:components": "vitest run tests/components",
    "test:pages": "vitest run tests/pages",
    "test:pages:smoke": "vitest run tests/pages --testNamePattern=\\[smoke\\]",
    "test:pages:behavior": "vitest run tests/pages --testNamePattern=\\[behavior\\]"
  },
  "dependencies": {
    "@geoman-io/maplibre-geoman-free": "^0.10.8",
    "@nuxtjs/robots": "^7.0.2",
    "@pinia/nuxt": "^1.0.3",
    "@sentry/nuxt": "^11.12.0",
    "@turf/turf": "^7.4.0",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vueuse/core": "^15.0.0",
    "circle-to-polygon": "^2.2.0",
    "consola": "^3.4.2",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "lodash": "^4.18.1",
    "maplibre-gl": "^6.18.0",
    "markdown-it": "^15.0.3",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-div": "^1.1.0",
    "mathjs": "^15.2.0",
    "nuxt": "4.6.4",
    "nuxt-gtag": "^5.0.0",
    "papaparse": "^5.7.1",
    "pinia": "^4.1.0",
    "plotly.js": "^4.3.0",
    "vuetify": "^4.3.3",
    "vuetify-nuxt-module": "^0.19.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.22",
    "@types/lodash": "^4.17.27",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "lightningcss": "^1.33.0",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "npm@12.2.2",
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.8"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "es5-ext": false
  }
}
